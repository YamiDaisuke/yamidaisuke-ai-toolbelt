#!/bin/bash
# ym — bootstrap spec-driven development projects with AI agent roles
# https://github.com/YamiDaisuke/yamidaisuke-ai-toolbelt

set -e

VERSION="0.1.0"
REPO_URL="https://github.com/YamiDaisuke/yamidaisuke-ai-toolbelt"

usage() {
  cat <<EOF
ym v$VERSION

Usage:
  ym bootstrap <project-name>   Bootstrap a new project in the current directory
  ym bootstrap                  Update an existing bootstrapped project

Options:
  -h, --help      Show this help
  -v, --version   Show version

Examples:
  mkdir my-app && cd my-app && ym bootstrap my-app
  cd existing-project && ym bootstrap
EOF
  exit "${1:-0}"
}

die() {
  echo "Error: $*" >&2
  exit 1
}

fetch_skeleton() {
  local dest="$1"
  echo "Fetching latest skeleton..."
  git clone --depth=1 --quiet "$REPO_URL" "$dest" || die "Failed to clone skeleton from $REPO_URL"
}

install_skeleton() {
  local SRC="$1"   # path to .ym/ inside the cloned repo

  # Copy only what the project needs: scripts and SPEC.md template
  mkdir -p .ym/scripts .ym/templates
  cp "$SRC/scripts/new-spec.sh" .ym/scripts/
  cp "$SRC/scripts/next-task.sh" .ym/scripts/
  cp "$SRC/scripts/qa-report.sh" .ym/scripts/
  cp "$SRC/scripts/migrate-versioning.sh" .ym/scripts/
  chmod +x .ym/scripts/*.sh

  cp "$SRC/templates/SPEC.md" .ym/templates/

  # Copy PR template to GitHub default location so it applies to manual PRs
  mkdir -p .github
  cp "$SRC/templates/PULL_REQUEST_TEMPLATE.md" .github/

  # Sync agents and skills into Claude Code directories
  mkdir -p .claude/agents .claude/commands/ym
  cp "$SRC/agents/"*.md .claude/agents/
  cp "$SRC/skills/ym/"*.md .claude/commands/ym/
}

cmd_bootstrap() {
  local PROJECT_NAME="$1"
  local TEMP_DIR
  TEMP_DIR=$(mktemp -d)
  trap 'rm -rf "$TEMP_DIR"' EXIT

  if [ -d ".ym" ]; then
    # UPDATE MODE — project name is not used
    [ -n "$PROJECT_NAME" ] && echo "Note: project name ignored — updating existing bootstrap."

    fetch_skeleton "$TEMP_DIR/repo"
    local SRC="$TEMP_DIR/repo/.ym"

    echo "Updating .ym/..."
    rm -rf .ym
    install_skeleton "$SRC"

    # Run any migration scripts shipped with the new skeleton
    for script in .ym/scripts/migrate-*.sh; do
      [ -f "$script" ] || continue
      echo "Running $(basename "$script")..."
      bash "$script"
    done

    echo ""
    echo "Updated:"
    echo "  .ym/"
    echo "  .claude/agents/"
    echo "  .claude/commands/"
    echo "  .github/PULL_REQUEST_TEMPLATE.md"
    echo ""
    echo "Review changes: git diff"
    echo "Commit:         git add .ym .claude docs && git commit -m 'chore: update to ym v$VERSION'"
  else
    # NEW PROJECT MODE
    [ -z "$PROJECT_NAME" ] && die "project name required\nUsage: ym bootstrap <project-name>"

    fetch_skeleton "$TEMP_DIR/repo"
    local SRC="$TEMP_DIR/repo/.ym"

    [ ! -d ".git" ] && git init --quiet

    install_skeleton "$SRC"

    mkdir -p docs/specs
    local TODAY
    TODAY=$(date +%Y-%m-%d)
    sed "s/{DATE}/$TODAY/g" "$SRC/templates/REQUIREMENTS.md" > docs/REQUIREMENTS.md
    sed "s/{DATE}/$TODAY/g" "$SRC/templates/ARCHITECTURE.md" > docs/ARCHITECTURE.md

    sed "s|{PROJECT_NAME}|$PROJECT_NAME|g" "$SRC/CLAUDE.md" > CLAUDE.md

    echo ""
    echo "Bootstrapped: $PROJECT_NAME"
    echo "  .ym/"
    echo "  .claude/agents/"
    echo "  .claude/commands/"
    echo "  .github/PULL_REQUEST_TEMPLATE.md"
    echo "  docs/REQUIREMENTS.md"
    echo "  docs/ARCHITECTURE.md"
    echo "  docs/specs/"
    echo "  CLAUDE.md"
    echo ""
    echo "Next: open this directory in Claude Code and start with the Architect agent."
  fi
}

case "${1:-}" in
  bootstrap)
    shift
    cmd_bootstrap "${1:-}"
    ;;
  -v|--version)
    echo "ym $VERSION"
    ;;
  -h|--help|"")
    usage 0
    ;;
  *)
    echo "Error: unknown command '$1'" >&2
    usage 1
    ;;
esac
